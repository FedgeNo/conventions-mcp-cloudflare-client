{
  "description": "Load Cloudflare-hosted conventions before using tools.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "conventions-mcp-cloudflare hook-session-rules",
            "timeout": 5,
            "statusMessage": "Checking Cloudflare-hosted conventions"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "conventions-mcp-cloudflare hook-pre-tool-check",
            "timeout": 5,
            "statusMessage": "Checking Cloudflare-hosted conventions"
          }
        ]
      }
    ]
  }
}
